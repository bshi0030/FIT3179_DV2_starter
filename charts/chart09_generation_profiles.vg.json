{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Generational shopping comparison; colour is a within-metric 0-100 relative score, with actual values labelled. Do not compare colour magnitudes across measures as raw units.",
  "width": "container",
  "height": 325,
  "data": {
    "url": "data/auspost_generation_profiles.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "stroke": "white",
        "strokeWidth": 3
      },
      "encoding": {
        "color": {
          "field": "normalized_score",
          "type": "quantitative",
          "title": "Position within measure",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#eaf4f2",
              "#176b75"
            ]
          }
        },
        "tooltip": [
          {
            "field": "generation",
            "title": "Generation"
          },
          {
            "field": "metric",
            "title": "Measure"
          },
          {
            "field": "display_value",
            "title": "Observed value"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "display_value"
        },
        "color": {
          "condition": {
            "test": "datum.normalized_score >= 62",
            "value": "#ffffff"
          },
          "value": "#1e3440"
        }
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "metric",
      "type": "nominal",
      "sort": [
        "Weekly online shopping",
        "Online share of spend",
        "Total online spend",
        "Average basket size"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelLimit": 155
      }
    },
    "y": {
      "field": "generation",
      "type": "nominal",
      "sort": [
        "Gen Z",
        "Millennials",
        "Gen X",
        "Baby Boomers",
        "Builders"
      ],
      "title": null
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    }
  }
}
