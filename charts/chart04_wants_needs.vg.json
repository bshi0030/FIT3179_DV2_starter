{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Relative discretionary and non-discretionary shares of total monthly household expenditure.",
  "width": "container",
  "height": 350,
  "data": {
    "url": "data/abs_total_spending.csv"
  },
  "transform": [
    {
      "fold": [
        "discretionary_million",
        "non_discretionary_million"
      ],
      "as": [
        "spending_type",
        "spending_million"
      ]
    },
    {
      "calculate": "datum.spending_type === 'discretionary_million' ? 'Discretionary' : 'Non-discretionary'",
      "as": "type_label"
    },
    {
      "calculate": "datum.spending_million / datum.total_million * 100",
      "as": "share_pct"
    }
  ],
  "mark": {
    "type": "line",
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%Y",
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "share_pct",
      "type": "quantitative",
      "title": "Share of household spending (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "color": {
      "field": "type_label",
      "type": "nominal",
      "title": null,
      "scale": {
        "range": [
          "#267c85",
          "#64788e"
        ]
      }
    },
    "tooltip": [
      {
        "field": "date",
        "type": "temporal",
        "title": "Month",
        "format": "%B %Y"
      },
      {
        "field": "type_label",
        "title": "Type"
      },
      {
        "field": "share_pct",
        "type": "quantitative",
        "title": "Share (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "orient": "top"
    }
  }
}
