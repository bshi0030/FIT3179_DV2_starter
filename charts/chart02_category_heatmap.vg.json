{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Percentage point change in category share of nine-category household spending since 2013; annual nominal composition.",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/abs_category_share.csv"
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "category",
      "type": "nominal",
      "title": null,
      "sort": [
        "Food",
        "Transport",
        "Health",
        "Recreation and culture",
        "Hotels, cafes and restaurants",
        "Furnishings and household equipment",
        "Clothing and footwear",
        "Alcoholic beverages and tobacco",
        "Miscellaneous goods and services"
      ]
    },
    "color": {
      "field": "share_change_pp_since_2013",
      "type": "quantitative",
      "title": "Change in share (pp)",
      "scale": {
        "scheme": "redblue",
        "domainMid": 0,
        "reverse": true
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "category",
        "title": "Category"
      },
      {
        "field": "share_pct",
        "type": "quantitative",
        "title": "Share (%)",
        "format": ".1f"
      },
      {
        "field": "share_change_pp_since_2013",
        "type": "quantitative",
        "title": "Change vs 2013 (pp)",
        "format": "+.2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    }
  }
}
