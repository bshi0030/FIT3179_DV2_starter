{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australian household spending, CPI-deflated into 2025 dollars, with optional nominal comparison.",
  "width": "container",
  "height": 365,
  "data": {
    "url": "data/abs_total_spending.csv"
  },
  "params": [
    {
      "name": "spendingView",
      "value": "Inflation-adjusted (2025 dollars)",
      "bind": {
        "input": "select",
        "options": [
          "Inflation-adjusted (2025 dollars)",
          "Nominal (current dollars)"
        ],
        "name": "View: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "spendingView === 'Inflation-adjusted (2025 dollars)' ? datum.real_total_2025_million : datum.total_million",
      "as": "display_spending"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#376c80"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "grid": false,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "display_spending",
          "type": "quantitative",
          "title": "Monthly household spending (A$ million)",
          "axis": {
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "real_total_2025_million",
            "type": "quantitative",
            "title": "2025-dollar spending (A$m)",
            "format": ",.1f"
          },
          {
            "field": "total_million",
            "type": "quantitative",
            "title": "Nominal spending (A$m)",
            "format": ",.1f"
          },
          {
            "field": "cpi_australia",
            "type": "quantitative",
            "title": "All-groups CPI",
            "format": ".2f"
          },
          {
            "field": "cpi_quarter",
            "title": "CPI quarter"
          },
          {
            "field": "cpi_carried_forward",
            "title": "Most recent quarter carried forward"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2020-04-01"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          5,
          5
        ],
        "strokeWidth": 1.5,
        "color": "#c84b31"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2020-04-01",
            "label": "2020 pandemic disruption"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 10,
        "dy": -6,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#ae5037"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "datum": 74000,
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      },
      "transform": []
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11
    },
    "title": {
      "font": "DM Sans"
    }
  }
}