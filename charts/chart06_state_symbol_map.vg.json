{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "2025 online spending per resident by state: Australia Post totals divided by June 2025 ABS population estimates.",
  "width": "container",
  "height": 430,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#efe7dc",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/state_positions.csv"
      },
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/auspost_state_spending.csv"
            },
            "key": "state_name",
            "fields": [
              "state",
              "online_spend_billion",
              "yoy_growth_pct",
              "population_june_2025",
              "spend_per_resident_aud"
            ]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.83,
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "color": "#267c85"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "spend_per_resident_aud",
          "type": "quantitative",
          "title": "2025 online spend per resident (AUD)",
          "scale": {
            "type": "sqrt",
            "domainMin": 0,
            "range": [
              100,
              2200
            ]
          },
          "legend": {
            "values": [
              1000,
              2000,
              3000
            ],
            "title": "Online spending per resident (A$)",
            "format": ",.0f",
            "symbolStrokeColor": "#ffffff"
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State / territory"
          },
          {
            "field": "spend_per_resident_aud",
            "type": "quantitative",
            "title": "Online spend / resident",
            "format": "$,.0f"
          },
          {
            "field": "online_spend_billion",
            "type": "quantitative",
            "title": "State online spend ($bn)",
            "format": ".1f"
          },
          {
            "field": "population_june_2025",
            "type": "quantitative",
            "title": "Population (Jun 2025)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    }
  }
}